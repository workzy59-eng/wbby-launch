rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSuperuser() {
      return isAuth() && (
        request.auth.uid in ['vN3cIRGUKXeEnbBCA4shsOXNlE03', 'Pc1bVwdIUHeAdoDyZWKv0VZ9OT73', 'uxoCnPC8Hyg2UNwbmSDnVrfs8PV2'] ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'sain17296174@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'workzy59@gmail.com')
      );
    }

    match /{document=**} {
      allow read, write: if isAuth();
    }

    match /_system_/{any} {
      allow read: if true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'workzy59@gmail.com'
      );
    }

    function isWhitelistedDeveloper() {
      return isAuth() && (
        isAdmin() ||
        (request.auth.token.email != null && (
         request.auth.token.email.lower() == 'aither2029@gmail.com' ||
         request.auth.token.email.lower() == 'sain17296174@gmail.com'
        ))
      );
    }

    // =========================
    // USERS & PROFILES
    // =========================
    match /users/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      allow get: if isAuth();
      allow list: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.uid == request.auth.uid);
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      function canAccessProject() {
        return isAdmin() || 
               isWhitelistedDeveloper() ||
               (resource != null && (
                 resource.data.userId == request.auth.uid || 
                 resource.data.developerId == request.auth.uid ||
                 resource.data.assignedTo == request.auth.uid
               ));
      }

      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow get: if isAuth() && canAccessProject();
      allow list: if isAuth() && (
        isAdmin() || 
        isWhitelistedDeveloper() ||
        resource.data.userId == request.auth.uid || 
        resource.data.developerId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid
      );

      allow update: if isAuth() && (
        isAdmin() ||
        existing().userId == request.auth.uid ||
        existing().developerId == request.auth.uid ||
        existing().assignedTo == request.auth.uid ||
        (isWhitelistedDeveloper() && (
          incoming().developerId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasAny(['domainPrice', 'paymentLink', 'paymentLinkBasic', 'paymentLinkPremium', 'websiteUrl', 'progress', 'status'])
        ))
      );

      allow delete: if isAdmin();

      // Project Messages
      match /messages/{messageId} {
        allow read: if isAuth() && canAccessProject();
        allow create: if isAuth() && incoming().senderId == request.auth.uid && canAccessProject();
        allow update: if isAuth();
      }
    }

    // =========================
    // CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {
      function getConversation() {
        return existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
          ? getAfter(/databases/$(database)/documents/conversations/$(conversationId))
          : get(/databases/$(database)/documents/conversations/$(conversationId));
      }

      function isParticipant() {
        return isAuth() && (
          isAdmin() || 
          request.auth.uid in resource.data.participants
        );
      }

      function isParticipantAfter() {
        return isAuth() && (
          isAdmin() || 
          request.auth.uid in getConversation().data.participants
        );
      }

      allow get: if isAuth() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow list: if isAuth() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow update: if isAuth() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create: if isAuth() && request.auth.uid in incoming().participants;

      match /messages/{messageId} {
        allow read: if isAuth() && isParticipantAfter();
        allow create: if isAuth() && incoming().senderId == request.auth.uid && isParticipantAfter();
        allow update: if isAuth() && (
          isAdmin() || 
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'seen', 'seenTime'])
        );
        allow delete: if isAdmin();
      }

      match /typing/{userId} {
        allow read: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || conversationId.contains(request.auth.uid));
        allow write: if isAuth() && (userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      }
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // =========================
    // LEAVES & ATTENDANCE
    // =========================
    match /leave_requests/{requestId} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow get: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.userId == request.auth.uid);
      allow list: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isWhitelistedDeveloper();
    }
    
    match /attendance/{attendanceId} {
      allow create: if isAuth() && (incoming().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow get: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.userId == request.auth.uid);
      allow update: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || request.auth.uid == resource.data.userId);
    }

    // =========================
    // SYSTEM COLLECTIONS
    // =========================
    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /developer_invites/{id} {
      allow read: if isAuth();
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /visit_sessions/{id} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow get: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.userId == request.auth.uid);
      allow list: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || resource.data.userId == request.auth.uid);
      allow update: if isAuth() && (isAdmin() || isWhitelistedDeveloper() || existing().userId == request.auth.uid);
    }

    match /meetings/{meetingId} {
      allow get: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow list: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow write: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid));
    }

    match /meeting_requests/{requestId} {
      allow read, write: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid));
    }
    
    // Generic catch-all for other collections used by admin
    match /payments/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /commissions/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /leads/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /developer_requests/{id} { allow create: if isAuth(); allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /sales_applications/{id} { allow create: if isAuth(); allow read, write: if isAdmin() || isWhitelistedDeveloper(); }

  }
}
