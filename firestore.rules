rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getRole(uid) {
      return getUserData(uid).role;
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == 'admin';
    }

    function isDeveloper() {
      return isSignedIn() && getRole(request.auth.uid) == 'developer';
    }

    function isClient() {
      return isSignedIn() && getRole(request.auth.uid) == 'client';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['client', 'developer', 'admin'] &&
             data.email is string && data.email.size() <= 128;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'businessName', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.businessName is string && data.businessName.size() <= 200 &&
             data.status in ['pending', 'assigned', 'in_progress', 'completed'] &&
             (!('developerId' in data) || data.developerId == null || isValidId(data.developerId));
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             data.createdAt == request.time &&
             (!('text' in data) || (data.text is string && data.text.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000));
    }

    // --- Rules ---

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'onboardingCompleted', 'updatedAt']) ||
        isAdmin()
      );
    }

    // Projects
    match /projects/{projectId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isOwner(resource.data.developerId) ||
        isAdmin()
      );
      
      allow list: if isSignedIn() && (
        isAdmin() || 
        (isDeveloper() && resource.data.developerId == request.auth.uid) ||
        resource.data.userId == request.auth.uid
      );
      
      allow create: if isClient() && isValidProject(incoming()) && incoming().userId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isDeveloper() && (
          // Allow claiming if unassigned
          (!('developerId' in existing()) || existing().developerId == null) &&
          incoming().developerId == request.auth.uid &&
          incoming().status == 'in_progress'
        ) || (
          // Allow updates if assigned
          existing().developerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progress', 'updatedAt', 'lastMessage', 'lastMessageAt', 'unreadCount'])
        )) ||
        (isOwner(existing().userId) && 
          incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'aiPrompt', 'clientDetails', 'updatedAt', 'unreadCount'])
        )
      );

      // Project Messages
      match /messages/{messageId} {
        function canChat() {
          let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
          return (request.auth.uid == project.userId || request.auth.uid == project.developerId) && 
                 (project.developerId != null);
        }

        allow read: if isSignedIn() && canChat();
        allow create: if isSignedIn() && canChat() && isValidMessage(incoming());
        allow update, delete: if false;
      }
    }

    // Settings (Public Read, Admin Write)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
