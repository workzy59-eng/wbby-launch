rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'workzy59@gmail.com' ||
          request.auth.token.email.lower() == 'sain17296174@gmail.com'
        )
      );
    }

    function isWhitelistedDeveloper() {
      return isAuth() && (
        isAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'aither2029@gmail.com' ||
          request.auth.token.email.lower() == 'sain17296174@gmail.com'
        ))
      );
    }

    // Default: Authenticated users can read/write everything to unblock development
    // This addresses the "Missing or insufficient permissions" error for the dashboard
    match /{document=**} {
      allow read, write: if isAuth();
    }

    // =========================
    // USERS & PROFILES
    // =========================
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      allow read, write: if isAuth();
      
      match /messages/{messageId} {
        allow read, write: if isAuth();
      }
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {
      allow read, write: if isAuth();
    }

    // =========================
    // CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {
      allow read, write: if isAuth();
      
      match /messages/{messageId} {
        allow read, write: if isAuth();
      }
      
      match /typing/{userId} {
        allow read, write: if isAuth();
      }
    }

    // =========================
    // SYSTEM COLLECTIONS
    // =========================
    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /developer_invites/{id} {
      allow read, write: if isAuth();
    }

    match /visit_sessions/{id} {
      allow read, write: if isAuth();
    }

    match /meetings/{meetingId} {
      allow read, write: if isAuth();
    }

    match /meeting_requests/{requestId} {
      allow read, write: if isAuth();
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAuth();
    }

    match /leave_requests/{requestId} {
      allow read, write: if isAuth();
    }

  }
}
