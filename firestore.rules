rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuth() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Safely checks for admin role with email fallback
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'workzy59@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      allow get: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      
      // Ensures the document being created belongs to the person creating it
      allow create: if isAuth() && incoming().userId == request.auth.uid;

      // Users can only read projects they are a part of (Fixed structure for listings)
      allow read, update: if isAuth() && (
        existing().userId == request.auth.uid || 
        (existing().developerId != null && existing().developerId == request.auth.uid) || 
        isAdmin()
      );

      allow delete: if isAdmin();

      // Project Messages (Subcollection)
      match /messages/{messageId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuth() && 
          incoming().senderId == request.auth.uid && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // =========================
    // CONVERSATIONS & MESSAGES
    // =========================
    match /conversations/{conversationId} {
      // FIX: safe fallback logic so that collection listings do not throw permission errors
      allow read, update: if isAuth() && (request.auth.uid in existing().participants || isAdmin());
      allow create: if isAuth() && request.auth.uid in incoming().participants;

      match /messages/{messageId} {
        allow read: if isAuth() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );

        allow create: if isAuth() && 
          incoming().senderId == request.auth.uid && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin()
        );

        allow update, delete: if false; 
      }
    }

    // =========================
    // ADMIN & SYSTEM COLLECTIONS
    // =========================
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /commissions/{id} { allow read, write: if isAdmin(); }
    match /leads/{id} { allow read, write: if isAdmin(); }

    match /developer_requests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /sales_applications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /developer_invites/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /visit_sessions/{id} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow update, read: if isAuth() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Meetings ---
    match /meetings/{meetingId} {
      // FIX: Split rules so creation evaluates incoming data, reads evaluate existing data
      allow create: if isAuth() && incoming().clientId == request.auth.uid;
      allow read, update: if isAuth() && (existing().clientId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // --- Leave Requests & Attendance ---
    match /leave_requests/{requestId} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow read: if isAdmin() || (isAuth() && existing().userId == request.auth.uid);
      allow update: if isAdmin();
    }
    
    match /attendance/{attendanceId} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow read: if isAdmin() || (isAuth() && existing().userId == request.auth.uid);
      allow update: if isAdmin();
    }

    // =========================
    // GLOBAL DENY (Safety Net)
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
