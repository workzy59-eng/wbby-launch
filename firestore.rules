rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

// ============================
    // HELPER FUNCTIONS
    // ============================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "workzy59@gmail.com" ||
        request.auth.token.email.lower() == "admin@webbylaunch.com" ||
        request.auth.token.email.lower() == "aither2029@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      );
    }

    function isDeveloper() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "aither2029@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer")
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['clientId', 'date', 'time', 'status']) &&
             data.clientId is string &&
             data.date is string &&
             data.time is string;
    }

    // ============================
    // SYSTEM
    // ============================

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================
    // USERS
    // ============================

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin() || isDeveloper() || resource.data.role == "admin");
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin()) && 
                    (!incoming().get('role', 'client') != existing().get('role', 'client') || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================
    // PROJECTS
    // ============================

    match /projects/{projectId} {
      allow read: if isSignedIn() &&
        (isAdmin() || isDeveloper() || resource.data.userId == request.auth.uid || resource.data.developerId == request.auth.uid);

      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid;

      allow update: if isSignedIn() &&
        (
          isAdmin() ||
          (
            (resource.data.userId == request.auth.uid || resource.data.developerId == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys()
              .hasOnly(['isDeleted', 'updatedAt', 'forcedStop', 'websiteName', 'domain', 'domainPreferences', 'progress', 'status', 'websiteUrl', 'startedAt', 'isLocked', 'unreadCount', 'lastMessage', 'lastMessageAt', 'lastSenderId'])
          )
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          (isAdmin() || isDeveloper() || get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid || get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid);
        allow create: if isSignedIn() && (incoming().senderId == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && (
          incoming().senderId == request.auth.uid || 
          isAdmin() || 
          isDeveloper() || 
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid
        );
        allow delete: if isAdmin();
      }
    }

    // ============================
    // CONVERSATIONS
    // ============================

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && (isAdmin() || request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          (isAdmin() || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]));
        
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow update: if isSignedIn() && (incoming().senderId == request.auth.uid || isAdmin() || get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]));
      }

      match /typing/{uid} {
        allow get, list: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }

    // ============================
    // MEETINGS
    // ============================

    match /meetings/{meetingId} {
      allow read: if isSignedIn() && (isAdmin() || isDeveloper() || resource.data.clientId == request.auth.uid || resource.data.adminId == request.auth.uid || resource.data.developerId == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || isDeveloper() || incoming().clientId == request.auth.uid) && isValidMeeting(incoming());
      allow update: if isSignedIn() && 
                    (isAdmin() || isDeveloper() || resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /meeting_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || isDeveloper() || resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isDeveloper() || (resource.data.clientId == request.auth.uid);
    }

    // ============================
    // OTHER
    // ============================

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid);
    }

    match /leave_requests/{requestId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || incoming().userId == request.auth.uid);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /visit_sessions/{sessionId} {
      allow read: if isSignedIn() && (isAdmin() || isDeveloper() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isDeveloper() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /developer_invites/{inviteId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // ============================
    // GLOBAL SAFETY NET (BOTTOM)
    // ============================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
