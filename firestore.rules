rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuth() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Safely checks for admin role with email fallback
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'workzy59@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isWhitelistedDeveloper() {
      return isAuth() && (
        isAdmin() ||
        request.auth.uid in ['Pc1bVwdIUHeAdoDyZWKv0VZ9OT73', 'uxoCnPC8Hyg2UNwbmSDnVrfs8PV2'] ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'sain17296174@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      // Single profile gets are allowed for any registered user (so developers and clients can view each other's details in chat/assignments)
      allow get: if isAuth();
      // List/Query users is allowed for admins & developers to search/collaborate
      allow list: if isAuth() && (isAdmin() || isWhitelistedDeveloper());
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      
      // Ensures the document being created belongs to the person creating it
      allow create: if isAuth() && incoming().userId == request.auth.uid;

      // Users can only read/update projects they are part of, or if whitelisted
      allow read, update: if isAuth() && (
        existing().userId == request.auth.uid || 
        (existing().developerId != null && existing().developerId == request.auth.uid) || 
        (existing().assignedTo != null && existing().assignedTo == request.auth.uid) ||
        isAdmin() ||
        isWhitelistedDeveloper()
      );

      allow delete: if isAdmin();

      // Project Messages (Subcollection)
      match /messages/{messageId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo == request.auth.uid ||
          isAdmin() ||
          isWhitelistedDeveloper()
        );
        allow create: if isAuth() && incoming().senderId == request.auth.uid && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo == request.auth.uid ||
          isAdmin() ||
          isWhitelistedDeveloper()
        );
        allow update: if isAuth() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.assignedTo == request.auth.uid ||
          isAdmin() ||
          isWhitelistedDeveloper()
        ) && (
          (!('senderId' in incoming()) || incoming().senderId == existing().senderId) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        );
      }
    }

    // =========================
    // CONVERSATIONS & MESSAGES
    // =========================
    match /conversations/{conversationId} {
      allow read, update: if isAuth() && (request.auth.uid in existing().participants || isAdmin() || isWhitelistedDeveloper());
      allow create: if isAuth() && request.auth.uid in incoming().participants;

      match /messages/{messageId} {
        allow read: if isAuth() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin() ||
          isWhitelistedDeveloper()
        );

        allow create: if isAuth() && incoming().senderId == request.auth.uid && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin() ||
          isWhitelistedDeveloper()
        );

        allow update: if isAuth() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants ||
          isAdmin() ||
          isWhitelistedDeveloper()
        ) && (
          (!('senderId' in incoming()) || incoming().senderId == existing().senderId) &&
          (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        );
      }

      match /typing/{userId} {
        allow read: if isAuth() && (
          isAdmin() ||
          isWhitelistedDeveloper() ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) ||
          (exists(/databases/$(database)/documents/projects/$(conversationId)) && (
            get(/databases/$(database)/documents/projects/$(conversationId)).data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/projects/$(conversationId)).data.developerId == request.auth.uid ||
            get(/databases/$(database)/documents/projects/$(conversationId)).data.assignedTo == request.auth.uid
          )) ||
          conversationId.matches('.*' + request.auth.uid + '.*')
        );
        allow write: if isAuth() && request.auth.uid == userId;
      }
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {
      allow read: if isAuth() && (
        isAdmin() || 
        isWhitelistedDeveloper() || 
        resource.data.userId == request.auth.uid
      );
      allow write: if isAuth();
    }

    // =========================
    // ADMIN & SYSTEM COLLECTIONS
    // =========================
    match /payments/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /commissions/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /leads/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }

    match /developer_requests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin() || isWhitelistedDeveloper();
    }

    match /sales_applications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin() || isWhitelistedDeveloper();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /developer_invites/{id} {
      allow read: if isAuth();
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /visit_sessions/{id} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow update, read: if isAuth() && (existing().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
    }

    // --- Meetings & Meeting Requests ---
    match /meetings/{meetingId} {
      allow create: if isAuth() && (incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid || isWhitelistedDeveloper());
      allow read, update: if isAuth() && (existing().clientId == request.auth.uid || existing().developerId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow delete: if isAdmin();
    }

    match /meeting_requests/{requestId} {
      allow read, write: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid));
    }

    // --- Leave Requests & Attendance ---
    match /leave_requests/{requestId} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow read: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && existing().userId == request.auth.uid);
      allow update: if isAdmin() || isWhitelistedDeveloper();
    }
    
    match /attendance/{attendanceId} {
      allow create: if isAuth() && (incoming().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow read: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && existing().userId == request.auth.uid);
      allow update: if isAdmin() || isWhitelistedDeveloper();
    }

    // --- Bio Logs ---
    match /bio_logs/{logId} {
      allow get: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow list: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow update, delete: if isAuth() && (existing().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
    }

    // =========================
    // GLOBAL DENY (Safety Net)
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
