rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isDeveloper() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer";
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // Create own profile
      allow create: if isAuth() && request.auth.uid == userId;

      // Read own + admin
      allow read: if isAuth() && (
        request.auth.uid == userId || isAdmin()
      );

      // Update own + admin
      allow update: if isAuth() && (
        request.auth.uid == userId || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {

      // Create project (client only)
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;

      // Read project
      allow read: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.developerId ||
        isAdmin()
      );

      // Update project
      allow update: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.developerId ||
        isAdmin()
      );

      // Delete project
      allow delete: if isAdmin();

      // =========================
      // PROJECT CHAT
      // =========================
      match /messages/{messageId} {

        allow read: if isAuth() && (
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
          request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.developerId
        );

        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          (
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.userId ||
            request.auth.uid == get(/databases/$(database)/documents/projects/$(projectId)).data.developerId
          );

        allow update, delete: if false;
      }
    }

    // =========================
    // CONVERSATIONS (OPTIONAL DM)
    // =========================
    match /conversations/{conversationId} {

      allow read: if isAuth() &&
        request.auth.uid in resource.data.participants;

      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {

        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow update, delete: if false;
      }
    }

    // =========================
    // MEETINGS
    // =========================
    match /meetings/{meetingId} {

      allow create: if isAuth();

      allow read: if isAuth() && (
        request.auth.uid == resource.data.clientId ||
        isAdmin()
      );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================
    // ADMIN ONLY COLLECTIONS
    // =========================
    match /developer_requests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /sales_applications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isAuth() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if isAdmin();
    }

    match /commissions/{id} {
      allow read: if isAuth() &&
        (request.auth.uid == resource.data.salesId || isAdmin());
      allow write: if isAdmin();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /developer_invites/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /visit_sessions/{id} {
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /leave_requests/{id} {
      allow create: if isDeveloper() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() ||
        request.auth.uid == resource.data.userId;
      allow update: if isAdmin();
    }

    match /attendance/{id} {
      allow create: if isDeveloper() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() ||
        request.auth.uid == resource.data.userId;
      allow update: if isAdmin();
    }

    match /leads/{id} {
      allow read, write: if isAdmin();
    }

    // =========================
    // DEFAULT BLOCK
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
