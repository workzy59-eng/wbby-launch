rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuth() {
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Safely checks for admin role with email fallback
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'workzy59@gmail.com' ||
        request.auth.token.email.lower() == 'priyankapudi4u@gmail.com' ||
        request.auth.token.email.lower() == 'sain17296174@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isWhitelistedDeveloper() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'sain17296174@gmail.com',
          'priyankapudi4u@gmail.com',
          'workzy59@gmail.com',
          'bharathmath1729@gmail.com',
          'aither2029@gmail.com'
        ] ||
        request.auth.uid in ['Pc1bVwdIUHeAdoDyZWKv0VZ9OT73', 'uxoCnPC8Hyg2UNwbmSDnVrfs8PV2']
      );
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      allow read: if isAuth();
      allow list: if isAdmin() || isWhitelistedDeveloper();
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      
      // FIX: Ensures the document being created belongs to the person creating it
      allow create: if isAuth() && 
        incoming().userId == request.auth.uid;

      // Users can only read projects they are a part of
      allow read: if isAuth() && (
        existing().userId == request.auth.uid || 
        (existing().developerId != null && existing().developerId == request.auth.uid) || 
        isAdmin()
      );

      // Only the owner, assigned developer, or admin can update
      // Whitelisted developers can accept unassigned projects or update financial intel pre-acceptance
      allow update: if isAuth() && (
        existing().userId == request.auth.uid ||
        (existing().developerId != null && existing().developerId == request.auth.uid) ||
        isAdmin() ||
        (existing().developerId == null && isWhitelistedDeveloper() && (
          // Case 1: Accepting the project
          (incoming().developerId == request.auth.uid) ||
          // Case 2: Setting financial intel before acceptance
          (incoming().diff(existing()).affectedKeys().hasAny(['domainPrice', 'paymentLink', 'paymentLinkBasic', 'paymentLinkPremium']))
        ))
      );

      allow delete: if isAdmin();

      // Project Messages (Subcollection)
      match /messages/{messageId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isAuth() && 
          incoming().senderId == request.auth.uid && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.developerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // =========================
    // CONVERSATIONS & MESSAGES
    // =========================
    match /conversations/{conversationId} {
      allow read, update: if isAdmin() || (isAuth() && request.auth.uid in resource.data.participants);
      allow create: if isAuth() && request.auth.uid in incoming().participants;

      match /messages/{messageId} {
        allow read: if isAdmin() || (isAuth() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow create: if isAdmin() || (isAuth() && 
          incoming().senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow update, delete: if isAdmin();
      }
    }

    // =========================
    // ADMIN & SYSTEM COLLECTIONS
    // =========================
    match /payments/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /commissions/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }
    match /leads/{id} { allow read, write: if isAdmin() || isWhitelistedDeveloper(); }

    match /developer_requests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin() || isWhitelistedDeveloper();
    }

    match /sales_applications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin() || isWhitelistedDeveloper();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /developer_invites/{id} {
      allow read: if isAuth();
      allow write: if isAdmin() || isWhitelistedDeveloper();
    }

    match /visit_sessions/{id} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow update: if isAuth() && (existing().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow read: if isAuth() && (existing().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
    }

    // --- Meetings ---
    match /meetings/{meetingId} {
      allow get: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow list: if isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      allow write: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid));
    }

    match /meeting_requests/{requestId} {
      allow read, write: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (resource.data.clientId == request.auth.uid || resource.data.developerId == request.auth.uid || incoming().clientId == request.auth.uid || incoming().developerId == request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth(); 
      allow update, delete: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && resource.data.userId == request.auth.uid);
    }
    
    // --- Leave Requests & Attendance ---
    match /leave_requests/{requestId} {
      allow create: if isAuth() && incoming().userId == request.auth.uid;
      allow read: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isWhitelistedDeveloper();
    }
    
    match /attendance/{attendanceId} {
      allow create: if isAuth() && (incoming().userId == request.auth.uid || isAdmin() || isWhitelistedDeveloper());
      // Allow reading if the doc doesn't exist yet (for getDoc checks) or if they own it
      allow read: if isAdmin() || isWhitelistedDeveloper() || (isAuth() && (resource == null || resource.data.userId == request.auth.uid));
      allow update: if isAuth() && (
        isAdmin() || isWhitelistedDeveloper() || (
          request.auth.uid == resource.data.userId &&
          request.time >= resource.data.punchIn + duration.value(5, 'h')
        )
      );
    }

    // =========================
    // GLOBAL DENY (Safety Net)
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
