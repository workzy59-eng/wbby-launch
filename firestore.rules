rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == "workzy59@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isDeveloper() {
      const email = request.auth.token.email;
      return isAuth() && (
        email == "sain17296174@gmail.com" ||
        email == "sin17296174@gmail.com" ||
        email == "aither2029@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      allow read: if isAuth();
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================
    // PROJECTS
    // =========================
    match /projects/{projectId} {
      allow create: if isAuth() &&
        request.resource.data.userId == request.auth.uid;
      
      allow read, update: if isAuth();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAuth();
        allow delete: if isAdmin() || (isAuth() && resource.data.senderId == request.auth.uid);
      }
      
      match /typing/{uid} {
        allow read, write: if isAuth();
      }
    }

    // =========================
    // CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {
      allow read, create, update: if isAuth();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create, update: if isAuth();
        allow delete: if isAdmin() || (isAuth() && resource.data.senderId == request.auth.uid);
      }
      
      match /typing/{uid} {
        allow read, write: if isAuth();
      }
    }

    // =========================
    // MEETINGS & REQUESTS
    // =========================
    match /meetings/{meetingId} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /meeting_requests/{requestId} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    // =========================
    // ADMIN / MISC COLLECTIONS
    // =========================
    match /developer_requests/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /sales_applications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    match /payments/{id} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /commissions/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /developer_invites/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /visit_sessions/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /attendance/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /leave_requests/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    match /leads/{id} {
      allow create, read, update: if isAuth();
      allow delete: if isAdmin();
    }

    // =========================
    // DEFAULT BLOCK
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
