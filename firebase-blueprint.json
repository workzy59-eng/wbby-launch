{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client", "developer"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "phone": { "type": "string" },
        "experience": { "type": "number" },
        "devRole": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "approved"] },
        "joiningDate": { "type": "string", "format": "date-time" },
        "absences": { "type": "number" },
        "isApproved": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Website project details and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "description": { "type": "string" },
        "templateId": { "type": "string" },
        "status": { "type": "string", "enum": ["Waiting for Review", "Under Review", "Accepted", "Rejected", "Development Started", "Completed", "completed", "active", "in-progress", "pending", "rejected"] },
        "progress": { "type": "number" },
        "estimatedCompletion": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "previewUrl": { "type": "string" }
      },
      "required": ["userId", "businessName", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message for a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "hiddenFor": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["projectId", "senderId", "text", "createdAt"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Developer leave request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "startDate", "endDate", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Developer attendance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "leave"] },
        "inTime": { "type": "string" },
        "outTime": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message conversation metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastSenderId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Article for the blog section.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "image": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      },
      "required": ["title", "slug", "content", "date"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["progress", "welcome", "system", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["userId", "title", "description", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project details."
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Project chat messages."
    },
    "/leave_requests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests."
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversation metadata."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct chat messages."
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Blog articles."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    }
  }
}
