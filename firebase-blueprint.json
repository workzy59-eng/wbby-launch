{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client", "developer", "sales"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "phone": { "type": "string" },
        "experience": { "type": "number" },
        "devRole": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "approved"] },
        "joiningDate": { "type": "string", "format": "date-time" },
        "absences": { "type": "number" },
        "isApproved": { "type": "boolean" },
        "commissionEarned": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Sales lead information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "phone": { "type": "string" },
        "businessType": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["Not Called", "Called", "Interested", "Not Interested", "Follow-up", "Closed"] },
        "notes": { "type": "string" },
        "followUpDate": { "type": "string", "format": "date-time" },
        "assignedSalesId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "phone", "status", "createdAt"]
    },
    "DeveloperApplication": {
      "title": "Developer Application",
      "description": "Application to join as a developer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "skills": { "type": "string" },
        "experience": { "type": "string" },
        "portfolio": { "type": "string" },
        "availability": { "type": "string" },
        "maxProjectsPerWeek": { "type": "number" },
        "expectedEarnings": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "status", "createdAt"]
    },
    "SalesApplication": {
      "title": "Sales Application",
      "description": "Application to join as a sales person.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "experience": { "type": "string" },
        "languages": { "type": "string" },
        "availability": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone", "status", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["one-time", "subscription"] },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "stripeSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "status", "createdAt"]
    },
    "Commission": {
      "title": "Commission",
      "description": "Sales commission record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salesId": { "type": "string" },
        "paymentId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["salesId", "paymentId", "amount", "status", "createdAt"]
    },
    "DeveloperInvite": {
      "title": "Developer Invite",
      "description": "Invitations for developers to join the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "code": { "type": "string" },
        "role": { "type": "string", "enum": ["developer", "senior developer"] },
        "permissions": {
          "type": "object",
          "properties": {
            "canChat": { "type": "boolean" },
            "canUpload": { "type": "boolean" },
            "canViewProjects": { "type": "boolean" }
          }
        },
        "joiningDate": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "used": { "type": "boolean" }
      },
      "required": ["name", "email", "code", "role", "permissions", "used", "createdAt"]
    },
    "VisitSession": {
       "title": "Visit Session",
       "description": "User activity tracking session.",
       "type": "object",
       "properties": {
         "id": { "type": "string" },
         "userId": { "type": "string" },
         "startTime": { "type": "string", "format": "date-time" },
         "endTime": { "type": "string", "format": "date-time" },
         "durationMinutes": { "type": "number" }
       },
       "required": ["userId", "startTime"]
    },
    "Project": {
      "title": "Project",
      "description": "Website project details and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "description": { "type": "string" },
        "templateId": { "type": "string" },
        "status": { "type": "string", "enum": ["Waiting for Review", "Under Review", "Accepted", "Rejected", "Development Started", "Completed", "completed", "active", "in-progress", "pending", "rejected"] },
        "progress": { "type": "number" },
        "estimatedCompletion": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "previewUrl": { "type": "string" }
      },
      "required": ["userId", "businessName", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message for a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "seen": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "hiddenFor": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["projectId", "senderId", "text", "createdAt"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Developer leave request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "startDate", "endDate", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Developer attendance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "absent", "leave"] },
        "inTime": { "type": "string" },
        "outTime": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message conversation metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastSenderId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "Article for the blog section.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "image": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      },
      "required": ["title", "slug", "content", "date"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Meeting scheduling and management.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "clientId": { "type": "string" },
        "adminId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "meetingLink": { "type": "string" },
        "platform": { "type": "string", "enum": ["Google Meet", "Zoom"] },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected", "Reschedule Requested", "Completed", "Missed"] },
        "rescheduleMessage": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "clientId", "adminId", "date", "time", "meetingLink", "status"]
    },
    "MeetingRequest": {
      "title": "Meeting Request",
      "description": "Client-initiated meeting requests.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "suggested"] },
        "adminResponse": { "type": "string" },
        "suggestedDate": { "type": "string" },
        "suggestedTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "preferredDate", "preferredTime", "status"]
    },
    "OTP": {
      "title": "OTP",
      "description": "Temporary One-Time Password for verification.",
      "type": "object",
      "properties": {
        "otp": { "type": "string" },
        "expiry": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["otp", "expiry"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration and feature flags.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requiredFields": { "type": "object" },
        "notifications": { "type": "object" },
        "maintenanceMode": { "type": "boolean" },
        "allowNewRegistrations": { "type": "boolean" },
        "baseWebsiteCost": { "type": "number" }
      },
      "required": ["requiredFields", "notifications", "maintenanceMode", "allowNewRegistrations", "baseWebsiteCost"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project details."
    },
    "/projects/{projectId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Project chat messages."
    },
    "/leave_requests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Leave requests."
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversation metadata."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct chat messages."
    },
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Blog articles."
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Meeting records."
    },
    "/meeting_requests/{requestId}": {
      "schema": "MeetingRequest",
      "description": "Client meeting requests."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Sales leads."
    },
    "/developer_applications/{applicationId}": {
      "schema": "DeveloperApplication",
      "description": "Developer applications."
    },
    "/sales_applications/{applicationId}": {
      "schema": "SalesApplication",
      "description": "Sales applications."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records."
    },
    "/commissions/{commissionId}": {
      "schema": "Commission",
      "description": "Sales commissions."
    },
    "/otps/{email}": {
      "schema": "OTP",
      "description": "Temporary OTP records (backend managed)."
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global application configuration."
    },
    "/developer_invites/{inviteId}": {
      "schema": "DeveloperInvite",
      "description": "Developer invitations."
    },
    "/visit_sessions/{sessionId}": {
      "schema": "VisitSession",
      "description": "User activity tracking sessions."
    }
  }
}
